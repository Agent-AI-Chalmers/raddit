# ── Backend (Go) ──────────────────────────────────────────
backend/raddit
backend/*.exe
backend/*.db
backend/*.db-shm
backend/*.db-wal
backend/uploads/*
!backend/uploads/.gitkeep

# ── Frontend (Node) ───────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/.env.*.local

# ── Uploads (root) ────────────────────────────────────────
uploads/*
!uploads/.gitkeep

# ── OS / Editor ───────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# ── Env / Secrets ─────────────────────────────────────────
.env
.env.local
*.pem
*.key
